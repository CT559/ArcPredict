# ─── ArcPredict Environment Variables ───────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Circle App-Kit Project Key (required for wallet connection)
NEXT_PUBLIC_KIT_KEY=your_circle_app_kit_key_here

# Arc Testnet RPC (optional override — defaults to public RPC)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.xyz

# App URL (used for OpenGraph)
NEXT_PUBLIC_APP_URL=http://localhost:3000
