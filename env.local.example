# ArcPredict Environment Variables
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ArcPredict

# Arc Testnet Configuration
NEXT_PUBLIC_ARC_CHAIN_ID=1234567
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.arc-testnet.example.com
NEXT_PUBLIC_ARC_CHAIN_NAME=Arc Testnet

# USDC Contract (mock address on Arc Testnet)
NEXT_PUBLIC_USDC_CONTRACT=0x1234567890abcdef1234567890abcdef12345678

# Admin (NEVER expose real secrets in frontend - this is demo only)
# In production, use server-side auth
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
